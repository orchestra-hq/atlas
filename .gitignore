.claude/settings.local.json
.DS_Store

# Build output
/bin/
/dist/
/atlas
coverage.out

# Scratch space for local, uncommitted notes (e.g. PR body files for ship.sh)
/.scratch/

# Local e2e: downloaded model weights and engine state
/models/
/.atlas-state/
# Acceptance runs (scripts/acceptance*.sh) — engine logs + state dirs they write
# into the repo root when run locally (on CI the runner is ephemeral).
/atlas-*.log
/.atlas-acceptance*/
/.atlas-m3/
/.atlas-m8/

# Conformance harness
node_modules/
__pycache__/
/conformance/.venv/
/conformance/results/

# Docs site (Astro Starlight) build artifacts
/website/dist/
/website/.astro/

#!/bin/sh
# Pre-commit: format/lint staged Go and markdown files.
# Enable once per clone:  git config core.hooksPath .githooks
set -e

# --- Go: golangci-lint fmt (gofumpt + goimports), then re-stage. Full lint
# runs in CI and via `make lint`; the hook only keeps formatting honest.
staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
if [ -n "$staged_go" ]; then
  if command -v golangci-lint >/dev/null 2>&1; then
    echo "$staged_go" | tr '\n' '\0' | xargs -0 golangci-lint fmt
    echo "$staged_go" | tr '\n' '\0' | xargs -0 git add
  else
    echo "pre-commit: golangci-lint not found (brew install golangci-lint) — skipping Go format" >&2
  fi
fi

# --- Markdown: prettier (format) + markdownlint-cli2 (verify, with auto-fix).
staged_md=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
[ -z "$staged_md" ] && exit 0

# Formatting: prettier normalizes tables (padded pipes), emphasis markers, etc.
if command -v prettier >/dev/null 2>&1; then
  FMT="prettier"
elif command -v npx >/dev/null 2>&1; then
  FMT="npx --yes prettier"
else
  FMT=""
fi
if [ -n "$FMT" ]; then
  echo "$staged_md" | tr '\n' '\0' | xargs -0 $FMT --write --log-level warn
fi

# Linting: markdownlint-cli2 fixes what it can, then must pass.
if command -v markdownlint-cli2 >/dev/null 2>&1; then
  LINT="markdownlint-cli2"
elif command -v npx >/dev/null 2>&1; then
  LINT="npx --yes markdownlint-cli2"
else
  echo "pre-commit: markdownlint-cli2 not found (brew install markdownlint-cli2 or install node) — skipping markdown lint" >&2
  exit 0
fi

echo "$staged_md" | tr '\n' '\0' | xargs -0 $LINT --fix || true
echo "$staged_md" | tr '\n' '\0' | xargs -0 git add
echo "$staged_md" | tr '\n' '\0' | xargs -0 $LINT
